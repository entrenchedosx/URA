{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "URA",
  "version": "0.1.0",
  "identifier": "dev.ura.reverse-engineer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "URA — Ultimate Reverse Engineer",
        "width": 1480,
        "height": 920,
        "minWidth": 1100,
        "minHeight": 680,
        "theme": "Dark",
        "backgroundColor": "#0A0C10",
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Ultimate Reverse Engineer",
    "longDescription": "A native binary inspection and x86/x64 disassembly workbench.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
